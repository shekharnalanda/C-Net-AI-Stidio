{
  "name": "cnet-ai-studio-desktop",
  "version": "1.0.0",
  "description": "Universal offline AI workspace with adaptive engine selection",
  "author": "C-Net AI Studio",
  "private": true,
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "in.mciedu.cnet.aistudio",
    "productName": "C-Net AI Studio Universal Offline",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "registry/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "C-Net-AI-Studio-Universal-Offline-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "C-Net-AI-Studio-Universal-Offline-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  }
}
